msgid "Unsupported Operating System"
msgstr "操作系统不支持"

#: AudioPlaybackConnector.cpp:42
msgid "AudioPlaybackConnector is not supported on this operating system version."
msgstr "此操作系统版本不支持 AudioPlaybackConnector。"

#: AudioPlaybackConnector.cpp:237
msgid "All connections will be closed.\nExit anyway?"
msgstr "所有连接将被关闭。\n确定退出吗？"

#: AudioPlaybackConnector.cpp:242
msgid "Reconnect on next start"
msgstr "下次启动时重新连接"

#: AudioPlaybackConnector.cpp:245
msgid "Exit"
msgstr "退出"

#: AudioPlaybackConnector.cpp:271
msgid "Language"
msgstr "语言"

#: AudioPlaybackConnector.cpp:271
msgid "Bluetooth Settings"
msgstr "蓝牙设置"

#: AudioPlaybackConnector.cpp:322
msgid "Disconnect All"
msgstr "断开全部"

#: AudioPlaybackConnector.cpp:336
msgid "Restart Bluetooth Audio"
msgstr "重启蓝牙音频"

#: AudioPlaybackConnector.cpp:370
msgid "Connecting"
msgstr "正在连接"

#: AudioPlaybackConnector.cpp:407
msgid "The request timed out"
msgstr "请求超时"

#: AudioPlaybackConnector.cpp:411
msgid "The operation was denied by the system"
msgstr "操作被系统拒绝"

#: AudioPlaybackConnector.cpp:422
msgid "Unknown error"
msgstr "未知错误"

#: AudioPlaybackConnector.cpp:447
msgid "Connected"
msgstr "已连接"

#: AudioPlaybackConnector.cpp:567
msgid "All Devices Disconnected"
msgstr "所有设备已断开"

#: AudioPlaybackConnector.cpp:569
msgid "All Bluetooth audio connections have been closed.\n\nYou can now reconnect your devices."
msgstr "所有蓝牙音频连接已关闭。\n\n现在可以重新连接设备。"

#: AudioPlaybackConnector.cpp:584
msgid "This will disconnect and reconnect the audio connections managed by AudioPlaybackConnector.\n\n"
"No system services are touched — only this app's own connections are affected.\n"
"Other Bluetooth devices (mouse, keyboard, etc.) will NOT be interrupted.\n\n"
"Do you want to continue?"
msgstr "这将断开并重新连接由 AudioPlaybackConnector 管理的音频连接。\n\n"
"不会触及其他系统服务 — 仅影响本程序自身的连接。\n"
"其他蓝牙设备（鼠标、键盘等）不会中断。\n\n"
"是否继续？"

#: AudioPlaybackConnector.cpp (language switch)
msgid "Language Changed"
msgstr "语言已更改"

msgid "Language has been set to English. Please restart AudioPlaybackConnector for the change to take effect."
msgstr "语言已设置为英文。请重启 AudioPlaybackConnector 以生效。"

msgid "Language has been set to Chinese. Please restart AudioPlaybackConnector for the change to take effect."
msgstr "语言已设置为中文。请重启 AudioPlaybackConnector 以生效。"
